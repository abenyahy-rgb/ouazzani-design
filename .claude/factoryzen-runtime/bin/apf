const [cmd, ...args] = process.argv.slice(2);
const C = { g:'\x1b[32m', r:'\x1b[31m', y:'\x1b[33m', d:'\x1b[2m', b:'\x1b[1m', x:'\x1b[0m' };
const out = s => process.stdout.write(s + '\n');
const rule = () => out(C.d + '─'.repeat(72) + C.x);

function check() {
  const proj = loadProject(process.cwd());
  const results = runAll(proj);
  rule();
  out(`${C.b}Contrôles déterministes${C.x}  ${C.d}${proj ? 'dépôt produit détecté' : 'registre seul — aucune arborescence product/'}${C.x}`);
  rule();
  for (const r of results) {
    const col = r.status === 'PASS' ? C.g : r.status === 'FAIL' ? C.r : C.y;
    out(`${col}${r.status.padEnd(8)}${C.x}${C.b}${r.id}${C.x}  ${r.name}`);
    out(`         ${C.d}${r.detail}${C.x}`);
    r.findings.slice(0, 12).forEach(f => out(`         ${C.r}·${C.x} ${f}`));
    if (r.findings.length > 12) out(`         ${C.d}… ${r.findings.length - 12} autres${C.x}`);
  }
  /* LES CONTRÔLES DU PROJET, exécutés ici — dans l'environnement du projet, jamais dans le
     Launchpad. Chacun sur le dépôt, puis ses tests négatifs sur une copie de fixture. */
  const pc = proj ? executerControles(process.cwd()) : { present: false };
  if (pc.present) {
    rule();
    out(`${C.b}Contrôles du projet${C.x}  ${C.d}controles/controles.yaml — ${pc.controles.length} contrôle(s)${C.x}`);
    for (const c of pc.controles) {
      const ok = c.depot === 'PASS' && c.negatifs.every(n => n.ok);
      out(`${ok ? C.g : C.r}${(ok ? 'PASS' : 'FAIL').padEnd(8)}${C.x}${C.b}${c.id}${C.x}  ${c.nom}  ${C.d}(${c.source}) · ${c.negatifs.filter(n => n.ok).length}/${c.negatifs.length} test(s) négatif(s) tenu(s)${C.x}`);
    }
    pc.findings.slice(0, 12).forEach(f => out(`         ${C.r}·${C.x} ${f.split('\n')[0]}`));
  }
  rule();
  const failed = results.filter(r => r.status === 'FAIL');
  const passed = results.filter(r => r.status === 'PASS').length;
  const skipped = results.filter(r => r.status === 'SKIPPED').length;
  out(`${passed} PASS · ${failed.length} FAIL · ${skipped} SKIPPED${pc.present ? ` · contrôles du projet : ${pc.findings.length ? `${pc.findings.length} écart(s)` : 'tenus'}` : ''}`);
  if (skipped) out(`${C.d}Un contrôle SKIPPED ne vaut pas PASS : il attend une instance de projet.${C.x}`);
  process.exit(failed.length || (pc.present && pc.findings.length) ? 1 : 0);
}

function show(kind, id) {
  const r = registry();
  const map = { activity:'activities', wp:'work_products', gate:'gates', agent:'agents',
                skill:'skills', control:'controls', principle:'principles' };
  if (!map[kind]) { out(`Objet inconnu : ${kind}. Attendu : ${Object.keys(map).join(' · ')}`); process.exit(2); }
  const o = kind === 'activity' ? activityFragment(id) : byId(r[map[kind]], id);
  if (!o) { out(`Introuvable : ${kind} ${id}`); process.exit(2); }
  out(JSON.stringify(o, null, 2));
}

function list(kind) {
  const r = registry();
  const map = { activities:'activities', wp:'work_products', gates:'gates', agents:'agents',
                skills:'skills', controls:'controls', principles:'principles' };
  const k = map[kind];
  if (!k) { out(`Collection inconnue. Attendu : ${Object.keys(map).join(' · ')}`); process.exit(2); }
  for (const o of r[k]) out(`${String(o.id).padEnd(22)} ${C.d}${o.name || o.mandate || o.rule || ''}${C.x}`.slice(0, 180));
}

function stats() {
  const r = registry();
  const full = JSON.stringify(r).length;
  const frag = JSON.stringify(activityFragment(12)).length;
  rule();
  out(`${C.b}${r.method.name} v${r.method.version}${C.x}  ${C.d}${r.method.status}${C.x}`);
  rule();
  const rows = [['cadences',r.cadences.length],['activités',r.activities.length],['livrables',r.work_products.length],
    ['gates',r.gates.length],['agents',r.agents.length],['skills',r.skills.length],
    ['contrôles',r.controls.length],['principes',r.principles.length],['entités de trace',r.traceability.length]];
  rows.forEach(([k,v]) => out(`  ${String(v).padStart(3)}  ${k}`));
  rule();
  out(`  registre complet          ${(full/1024).toFixed(1)} ko`);
  out(`  fragment d'une activité   ${(frag/1024).toFixed(1)} ko  ${C.d}soit ${(frag/full*100).toFixed(1)} % — ce qu'un agent reçoit${C.x}`);
  const impl = r.controls.filter(c => c.implemented).length;
  out(`  contrôles implémentés     ${impl} / ${r.controls.length}`);
}

